{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mizcausevic-dev/financial-decision-record-audit-stream/blob/main/schema/financial-decision-event.schema.json",
  "title": "Financial Decision Record Audit Event",
  "description": "Hash-chained append-only ledger event describing which AI tool read which financial customer / applicant record, when, under which CFPB / OCC / FRB / FDIC / FCRA / ECOA / GLBA / BSA-AML / Section-1071 / Section-1033 regulatory basis, under which buyer-published Decision Card. Covers consumer credit (cards, BNPL, personal loans, lines of credit), deposit-account opening, payment authorization, fraud detection, AML/BSA KYC, robo-advisor recommendations, and small business lending under CFPB Section 1071 — under one schema with kind enum branching. EXCLUDES mortgage (handled by the PropTech sibling) and insurance (InsurTech). Designed to bridge core-banking + ACH + card-network semantics to the Kinetic Gain Protocol Suite audit-stream spine.",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "kind",
    "source",
    "subject_ref",
    "resource",
    "action",
    "outcome",
    "agent",
    "regulatory_basis",
    "decision_card_ref",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id":                  {"type": "string", "minLength": 1, "description": "UUID v7 or similar monotonic ID"},
    "timestamp":                 {"type": "string", "format": "date-time"},
    "kind": {
      "type": "string",
      "enum": [
        "fintech.consumer-credit.application-read",
        "fintech.consumer-credit.recommendation-produced",
        "fintech.consumer-credit.adverse-action-evaluated",
        "fintech.consumer-credit.line-management-evaluated",
        "fintech.deposit-account.opening-evaluated",
        "fintech.deposit-account.kyc-screening-produced",
        "fintech.payment.authorization-evaluated",
        "fintech.payment.fraud-flagged",
        "fintech.aml-bsa.sar-candidate-produced",
        "fintech.aml-bsa.ctr-candidate-produced",
        "fintech.robo-advisor.recommendation-produced",
        "fintech.section-1071-small-business.application-read",
        "fintech.section-1071-small-business.recommendation-produced",
        "fintech.section-1071-small-business.adverse-action-evaluated",
        "fintech.deletion-requested"
      ]
    },
    "source":                    {"type": "string", "minLength": 1, "description": "The system that emitted the event (e.g. 'meridian-core-banking', 'vendorf-creditmind-4.x', 'meridian-fraud-engine')"},
    "subject_ref": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": {"type": "string", "enum": ["consumer-id-tokenized", "applicant-id-tokenized", "deposit-account-id-tokenized", "card-account-id-tokenized", "small-business-applicant-id-tokenized", "ein-tokenized", "internal-tokenized"]},
        "value":  {"type": "string", "minLength": 1, "description": "Tokenized customer / applicant identifier — RAW SSN, EIN, account number, name, DOB, email, phone MUST NOT appear"}
      }
    },
    "product_line": {
      "type": "string",
      "enum": [
        "credit-card",
        "personal-loan-installment",
        "personal-line-of-credit",
        "auto-loan",
        "student-loan-refi",
        "buy-now-pay-later",
        "deposit-checking",
        "deposit-savings",
        "deposit-money-market",
        "deposit-cd",
        "payment-rail-ach",
        "payment-rail-card",
        "payment-rail-rtp-fednow",
        "payment-rail-wire",
        "investment-robo-advisor",
        "investment-self-directed",
        "small-business-loan",
        "small-business-line-of-credit",
        "small-business-credit-card"
      ]
    },
    "resource": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type":           {"type": "string", "enum": ["consumer-credit-application", "small-business-credit-application-section-1071", "deposit-account-application", "credit-bureau-tradeline", "credit-bureau-inquiry-history", "alternative-data-cashflow", "alternative-data-bnpl-history", "device-fingerprint", "ip-geolocation", "telephony-metadata", "transaction-history", "payment-instruction", "kyc-document-id", "kyc-document-proof-of-address", "aml-screening-list-result", "robo-investor-profile-questionnaire", "adverse-action-notice", "credit-line-management-event"]},
        "id_tokenized":   {"type": "string", "minLength": 1, "description": "Tokenized resource ID"},
        "fields_accessed":{"type": "array", "items": {"type": "string"}, "description": "Logical field names accessed"}
      }
    },
    "action": {
      "type": "string",
      "enum": ["C", "R", "U", "D", "E"]
    },
    "outcome": {
      "type": "string",
      "enum": ["0", "4", "8", "12"]
    },
    "agent": {
      "type": "object",
      "required": ["ai_tool_card_url", "ai_decision_card_url"],
      "additionalProperties": false,
      "properties": {
        "ai_tool_card_url":     {"type": "string", "format": "uri"},
        "ai_decision_card_url": {"type": "string", "format": "uri"},
        "principal":            {"type": "string"}
      }
    },
    "regulatory_basis": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "cfpb-ai-bulletin-2023",
            "cfpb-section-1071-small-business",
            "cfpb-section-1033-financial-data-rights",
            "cfpb-udaap-12-cfr-1031",
            "occ-frb-fdic-joint-ai-statement-2023",
            "occ-bulletin-2011-12-model-risk-management",
            "frb-sr-11-7-model-risk-management",
            "ecoa-reg-b-12-cfr-1002",
            "fcra-reg-v-12-cfr-1022",
            "glba-safeguards-16-cfr-314",
            "glba-financial-privacy-12-cfr-1016",
            "bsa-aml-31-cfr-1010",
            "sec-finra-investment-recommendation-best-interest",
            "consumer-explicit-opt-in-granted",
            "judicial-order-or-subpoena"
          ]
        },
        "citation":         {"type": "string"},
        "consent_record_uri":{"type": "string", "format": "uri"}
      }
    },
    "decision_card_ref":       {"type": "string", "format": "uri"},
    "records_of_disclosure_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logged_in_ecoa_record":      {"type": "boolean", "description": "Whether this event is captured in the lender's 12 CFR §1002.12 25-month recordkeeping log"},
        "logged_in_section_1071_lar": {"type": "boolean", "description": "Whether this event is captured in the Section 1071 small business LAR"},
        "logged_in_glba_log":         {"type": "boolean", "description": "Whether this event is captured in the institution's GLBA Safeguards vendor-monitoring log"},
        "logged_in_bsa_aml_log":      {"type": "boolean", "description": "Whether this event is captured in the BSA/AML monitoring log"},
        "log_entry_uri":              {"type": "string", "format": "uri"}
      }
    },
    "purpose_of_use":          {"type": "string"},
    "redaction_applied":       {"type": "array", "items": {"type": "string"}},
    "ai_recommendation": {
      "type": "object",
      "description": "OPTIONAL — present on *.recommendation-produced + *.evaluated + *.flagged events. Never autonomous on adverse-action — that requires a human credit officer / AML investigator / fraud analyst.",
      "additionalProperties": false,
      "properties": {
        "recommendation":            {"type": "string", "enum": ["approve", "approve-with-conditions", "counter-offer", "decline", "refer-to-human", "investigate-further", "no-action", "freeze", "reduce-line", "increase-line"]},
        "reason_codes":              {"type": "array", "items": {"type": "string"}, "description": "Reason codes per the institution's reason-code dictionary — NOT the FCRA/ECOA adverse-action statutory codes"},
        "model_version":             {"type": "string"},
        "model_confidence":          {"type": "number", "minimum": 0, "maximum": 1},
        "human_credit_officer_required": {"type": "boolean", "description": "MUST be true on any event whose recommendation could trigger an adverse-action notice (ECOA 12 CFR §1002.9 + CFPB UDAAP + OCC/FRB/FDIC joint AI statement governance expectation)"}
      }
    },
    "fcra_governance": {
      "type": "object",
      "description": "OPTIONAL — present when resource.type involves credit-bureau data",
      "additionalProperties": false,
      "properties": {
        "permissible_purpose":   {"type": "string", "enum": ["credit-transaction-initiated-by-consumer", "review-of-account", "extension-of-credit", "employment-purposes", "insurance-underwriting", "judicial-order", "consumer-written-instruction"]},
        "consumer-dispute-pathway-uri": {"type": "string", "format": "uri"},
        "adverse-action-fcra-615-notice-template-id": {"type": "string"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ip_hashed":      {"type": "string"},
        "tls_version":           {"type": "string"}
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "signer_key_uri", "signature_b64"],
      "additionalProperties": false,
      "properties": {
        "algorithm":     {"type": "string", "const": "ed25519"},
        "signer_key_uri":{"type": "string", "format": "uri"},
        "signature_b64": {"type": "string"}
      }
    },
    "prev_hash":               {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash":                    {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
